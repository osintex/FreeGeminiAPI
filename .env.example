# Server configuration
PORT=9656
HOST=127.0.0.1

# Optional proxy protection (leave empty to disable)
PROXY_API_KEY=

# Path to auth config file (default: ./gemini-auth.json)
GEMINI_AUTH_PATH=./gemini-auth.json

# Default model when not specified in request
DEFAULT_MODEL=gemini-2.0-flash

# Enable extended reasoning/thinking mode by default (0 or 1)
GEMINI_THINKING=0

# Request timeouts (ms)
GEMINI_FETCH_TIMEOUT_MS=60000
